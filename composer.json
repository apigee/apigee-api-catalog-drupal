{
    "name": "drupal/apigee_api_catalog",
    "license": "GPL-2.0",
    "type": "drupal-module",
    "description": "Apigee API Catalog for Drupal",
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "drupal/entity": "^1.6",
        "drupal/file_link": "^2.2",
        "drupal/apigee_edge": "dev-issue-1262 || dev-php-8.4-4.x",
        "webonyx/graphql-php": "^15.19"
    },
    "require-dev": {
        "cweagans/composer-patches": "^1.7",
        "drupal/core-dev": "^10.6 || ^11.3",
        "drush/drush": "^12.4.3 || ^13.3",
        "mglaman/drupal-check": "^1.5",
        "phpmd/phpmd": "^2.15.0",
        "phpmetrics/phpmetrics": "^2.8",
        "phpstan/phpstan": "^1.12"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "forked-apigee_edge",
            "type": "vcs",
            "url": "https://github.com/shailesh-google/apigee-edge-drupal"
        },
        {
            "name": "forked-apigee-client-php",
            "type": "vcs",
            "url": "https://github.com/shailesh-google/apigee-client-php",
            "canonical": false
        },
        {
            "name": "forked-apigee-mock-client-php",
            "type": "vcs",
            "url": "https://github.com/shailesh-google/apigee-mock-client-php",
            "canonical": false
        }
    ]
}
